# Glossa 数据库连接配置
DATABASE_URL=postgresql://glossa:glossa_local_dev@127.0.0.1:54329/glossa
GLOSSA_DB_SCHEMA=glossa

# 本地源码工作区根目录（支持指向单个 Git 仓库或包含多个子仓的工作区目录）
GLOSSA_WORKSPACE_ROOT=/path/to/your/codebase

# 项目领域背景简述（注入给业务参谋与伴读助手的全局背景提示词，可选）
GLOSSA_DOMAIN_CONTEXT=

# 管理员初始登录口令（至少 8 位）与 API Key 加密主密钥（至少 16 位）
GLOSSA_ADMIN_PASSWORD=glossa-admin-2026
GLOSSA_MASTER_KEY=glossa-local-master-encryption-key-2026

# 可选：默认大模型 API Key（也可在 Web 界面右上角「AI 配置」中可视化保存）
DEEPSEEK_API_KEY=
