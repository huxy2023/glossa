{
  "name": "@glossa/api",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "db:push": "drizzle-kit push --config=../../drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=../../drizzle.config.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/lexicon.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@glossa/schema": "workspace:*",
    "chokidar": "^3.6.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
